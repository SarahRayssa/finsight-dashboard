// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  description String
  value       Float
  type        String
  category    String?   @default("geral")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
